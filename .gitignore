# Dependency directories (Never commit these, they are easily reinstalled)
node_modules/
jspm_packages/
web_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Diagnostic reports (Crashed node apps)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul or jest
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Build and Production Outputs
dist/
build/
out/

# Local environment variables / Secrets (CRITICAL: Never commit your API keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
! .env.example

# TypeScript cache
*.tsbuildinfo

# Optional IDE and editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db
